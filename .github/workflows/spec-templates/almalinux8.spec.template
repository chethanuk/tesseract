%define _signature gpg
%define _gpg_name Tesseract OCR Build Bot

Name: tesseract-ocr
Version: ${TESSERACT_VERSION}
Release: 1.el8.leptonica${LEPTONICA_VERSION}
Summary: Tesseract OCR engine
License: Apache-2.0
URL: https://github.com/tesseract-ocr/tesseract
Source0: tesseract-${TESSERACT_VERSION}.tar.gz
Source1: leptonica-${LEPTONICA_VERSION}.tar.gz

BuildRequires: gcc-c++
BuildRequires: cmake
BuildRequires: libtool
BuildRequires: autoconf
BuildRequires: automake
BuildRequires: libjpeg-devel
BuildRequires: libpng-devel
BuildRequires: libtiff-devel
BuildRequires: zlib-devel
BuildRequires: libwebp-devel
BuildRequires: giflib-devel
BuildRequires: openjpeg2-devel
BuildRequires: libcurl-devel
BuildRequires: libarchive-devel
BuildRequires: git

Requires: libjpeg
Requires: libpng
Requires: libtiff
Requires: zlib
Requires: libwebp
Requires: giflib
Requires: openjpeg2-libs
Requires: libcurl
Requires: libarchive

%define install_prefix /usr/local

%description
Tesseract is an OCR engine with support for many languages.
This package includes both Tesseract ${TESSERACT_VERSION} and Leptonica ${LEPTONICA_VERSION}.

%prep
# Files are already extracted and built

%build
# Already built in previous steps

%install
mkdir -p %{buildroot}%{install_prefix}/bin
mkdir -p %{buildroot}%{install_prefix}/lib
mkdir -p %{buildroot}%{install_prefix}/lib/pkgconfig
mkdir -p %{buildroot}%{install_prefix}/include
mkdir -p %{buildroot}%{install_prefix}/share/tessdata
mkdir -p %{buildroot}%{install_prefix}/share/man/man1


# Copy binaries
cp -a %{install_prefix}/bin/tesseract %{buildroot}%{install_prefix}/bin/

# Copy libraries
(cd %{install_prefix}/lib && tar cf - .) | (cd %{buildroot}%{install_prefix}/lib && tar xf -)

# Copy pkgconfig files individually (they might already exist from the tar above)
cp -f %{install_prefix}/lib/pkgconfig/tesseract.pc %{buildroot}%{install_prefix}/lib/pkgconfig/ || true
cp -f %{install_prefix}/lib/pkgconfig/lept.pc %{buildroot}%{install_prefix}/lib/pkgconfig/ || true

# Copy include directories using tar to avoid command line length issues
if [ -d "%{install_prefix}/include/tesseract" ]; then
  (cd %{install_prefix}/include && tar cf - tesseract) | (cd %{buildroot}%{install_prefix}/include && tar xf -)
fi
if [ -d "%{install_prefix}/include/leptonica" ]; then
  (cd %{install_prefix}/include && tar cf - leptonica) | (cd %{buildroot}%{install_prefix}/include && tar xf -)
fi

# Copy tessdata files
if [ -d "%{install_prefix}/share/tessdata" ]; then
  find %{install_prefix}/share/tessdata -maxdepth 1 -type f \( -name "*.configs" -o -name "*.config" -o -name "pdf.ttf" \) -exec cp -a {} %{buildroot}%{install_prefix}/share/tessdata/ \;
  [ -f "%{install_prefix}/share/tessdata/osd.traineddata" ] && cp -a %{install_prefix}/share/tessdata/osd.traineddata %{buildroot}%{install_prefix}/share/tessdata/
  [ -f "%{install_prefix}/share/tessdata/eng.traineddata" ] && cp -a %{install_prefix}/share/tessdata/eng.traineddata %{buildroot}%{install_prefix}/share/tessdata/
fi

# Copy man page
[ -f "%{install_prefix}/share/man/man1/tesseract.1" ] && cp -a %{install_prefix}/share/man/man1/tesseract.1 %{buildroot}%{install_prefix}/share/man/man1/

# Ensure man page exists for RPM packaging (create empty file if missing)
if [ ! -f "%{buildroot}%{install_prefix}/share/man/man1/tesseract.1" ]; then
  touch %{buildroot}%{install_prefix}/share/man/man1/tesseract.1
fi

%post
echo "%{install_prefix}/lib" > /etc/ld.so.conf.d/tesseract.conf
ldconfig

%postun
rm -f /etc/ld.so.conf.d/tesseract.conf
ldconfig

%files
%{install_prefix}/bin/tesseract
%{install_prefix}/lib/libtesseract.so*
%{install_prefix}/lib/libleptonica.so*
%{install_prefix}/lib/libtesseract.a
%{install_prefix}/lib/libleptonica.a
%{install_prefix}/lib/libtesseract.la
%{install_prefix}/lib/libleptonica.la
%{install_prefix}/lib/cmake/
%{install_prefix}/lib/pkgconfig/tesseract.pc
%{install_prefix}/lib/pkgconfig/lept.pc
%{install_prefix}/include/tesseract/
%{install_prefix}/include/leptonica/
%{install_prefix}/share/tessdata/
%{install_prefix}/share/man/man1/tesseract.1

%changelog
* ${DATE} Tesseract OCR Build Bot <tesseract-chethan-build@github.com> - ${TESSERACT_VERSION}-1.el8.leptonica${LEPTONICA_VERSION}
- Automated build of Tesseract ${TESSERACT_VERSION} with Leptonica ${LEPTONICA_VERSION}
- Built for AlmaLinux 8
